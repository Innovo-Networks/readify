# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (South Africa - ZAR)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_BASE_URL=https://api-m.paypal.com

# Coinbase Commerce
COINBASE_COMMERCE_API_KEY=your-coinbase-api-key
COINBASE_WEBHOOK_SECRET=your-coinbase-webhook-secret

# App
NEXT_PUBLIC_APP_URL=https://readify.co.za
NEXT_PUBLIC_APP_NAME=Readify

# Optional integrations (hidden in the UI until switched on)
# PayPal shows automatically once NEXT_PUBLIC_PAYPAL_CLIENT_ID holds a real client ID.
NEXT_PUBLIC_COINBASE_ENABLED=false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Google Drive (for ebook serving)
GOOGLE_DRIVE_API_KEY=your-google-api-key

# PayFast (South Africa). Sandbox credentials below are PayFast's public test account.
# Set NEXT_PUBLIC_PAYFAST_ENABLED=true to show PayFast at checkout.
NEXT_PUBLIC_PAYFAST_ENABLED=false
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
PAYFAST_SANDBOX=true

# Book report alerts (Resend)
RESEND_API_KEY=
BOOK_REPORT_NOTIFY_EMAIL=
BOOK_REPORT_FROM_EMAIL=
